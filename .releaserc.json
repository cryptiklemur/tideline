{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      { "changelogFile": "CHANGELOG.md" }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/release-prepare.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "src-tauri/tauri.conf.json",
          "src-tauri/Cargo.toml",
          "Cargo.lock"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "target/release/bundle/deb/*.deb",
            "label": "Debian package (.deb) ${nextRelease.gitTag}"
          },
          {
            "path": "target/release/bundle/rpm/*.rpm",
            "label": "RPM package ${nextRelease.gitTag}"
          },
          {
            "path": "target/release/bundle/appimage/*.AppImage",
            "label": "AppImage ${nextRelease.gitTag}"
          }
        ]
      }
    ]
  ]
}
