{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tideline",
  "version": "1.0.1",
  "identifier": "com.cryptiklemur.tideline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Tideline",
        "width": 1300,
        "height": 720,
        "minWidth": 690,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tideline-plugin:; script-src 'self' 'unsafe-inline' tideline-plugin:; style-src 'self' 'unsafe-inline' tideline-plugin:; img-src 'self' data: tideline-plugin:; connect-src 'self' tideline-plugin: ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
